{
  "name": "navigi-sbaro-bot",
  "version": "2.0.0",
  "description": "Enhanced Telegram Bot for NAVIGI SBARO with Firebase integration and admin dashboard",
  "main": "bot-setup.js",
  "scripts": {
    "start": "node start-bots.js",
    "start:main": "node telegram-bot/bot.js",
    "start:admin": "node admin-bot-setup.js", 
    "dev": "nodemon start-bots.js",
    "dev:main": "nodemon telegram-bot/bot.js",
    "dev:dashboard": "cd admin-dashboard && python -m http.server 8080",
    "lint": "eslint *.js telegram-bot/*.js",
    "test": "npm run lint && npm run test:connection",
    "test:connection": "node -e \"console.log('✅ Node.js setup verified')\"",
    "deploy": "npm run test && npm start",
    "logs": "tail -f bot.log",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop navigi-bot",
    "pm2:restart": "pm2 restart navigi-bot",
    "pm2:logs": "pm2 logs navigi-bot"
  },
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "uuid": "^9.0.1",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^3.0.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.57.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "firebase",
    "navigi",
    "sbaro",
    "admin-dashboard",
    "real-time"
  ],
  "author": "NAVIGI Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navigi/sbaro-bot.git"
  }
}